# ai-agent-platform 环境变量示例
# 复制为 .env（已 gitignore）或在部署环境中注入以下变量
# 生成随机 JWT 密钥：openssl rand -base64 48

# 数据库
DB_URL=jdbc:mysql://localhost:3306/agent_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=请填入数据库密码

# JWT（>=32 字节随机字符串，必填）
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# 服务端口
SERVER_PORT=8080

# 日志级别
LOG_LEVEL=info

# 公开门户限流（每 IP 每分钟）
PORTAL_ANON_RATE_LIMIT=30
PORTAL_KEYED_RATE_LIMIT=120
